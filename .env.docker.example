# Docker Compose 환경변수 템플릿
# 사용법: 배포 서버에서 cp .env.docker.example .env 후 SESSION_SECRET 값 채우기

# iron-session 암호화 키 — 반드시 32자 이상의 랜덤 문자열로 교체
# 생성 명령: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_ME_WITH_RANDOM_64_HEX_CHARS_FROM_ABOVE_COMMAND

# 호스트에서 노출할 포트 (리버스 프록시 뒤에 둘 때는 그대로 3000 OK)
APP_PORT=3000

# 백업 보관 개수 (이보다 오래된 백업 자동 삭제)
BACKUP_KEEP=30

# 백업 주기 (초). 기본 86400 = 24시간
BACKUP_INTERVAL_SECONDS=86400
